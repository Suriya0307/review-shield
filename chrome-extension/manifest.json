{
  "manifest_version": 3,
  "name": "Review Shield",
  "version": "1.0.0",
  "description": "Detect fake reviews on e-commerce platforms",

  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": [
    "https://amazon.in/*",
    "https://www.amazon.in/*",
    "https://amazon.com/*",
    "https://www.amazon.com/*",
    "https://www.flipkart.com/*",
    "https://www.myntra.com/*"
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Review Shield"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://amazon.in/*",
        "https://www.amazon.in/*",
        "https://amazon.com/*",
        "https://www.amazon.com/*",
        "https://www.flipkart.com/*",
        "https://www.myntra.com/*",
         "https://openrouter.ai/*"
      ],
      "js": [
        "content/reviewScanner.js",
        "services/api.js",
        "content/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
